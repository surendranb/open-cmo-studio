# Open CMO Studio — Environment Configuration Example

# Meta Model API & Model Configuration
META_API_KEY=your_meta_api_key_here
DEFAULT_MODEL=meta/muse-spark-1.3

# Local Observability & Tracing (Arize Phoenix)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=open-cmo-studio

# Local Experiential Memory (Vectorize Hindsight)
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_BANK_ID=open-cmo-studio

# Optional MCP Adapters (Google Analytics & Search Console)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GA4_PROPERTY_ID=123456789
# GSC_SITE_URL=sc-domain:yourdomain.com
