{
  "$schema": "https://opencode.ai/config.json",
  "name": "open-cmo-studio-template",
  "model": "meta-llama/llama-3.3-70b-instruct",
  "instructions": [
    "AGENTS.md"
  ],
  "experimental": {
    "openTelemetry": true
  },
  "plugin": [
    "opencode-scheduler",
    [
      "@vectorize-io/opencode-hindsight",
      {
        "hindsightApiUrl": "http://127.0.0.1:8888",
        "bankId": "open-cmo-studio",
        "autoRecall": true,
        "autoRetain": true,
        "recallBudget": "mid"
      }
    ]
  ],
  "skills": {
    "paths": [
      "./.opencode/skills"
    ]
  },
  "permission": {
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "sudo*": "deny"
    },
    "webfetch": "allow"
  },
  "agent": {
    "cmo": {
      "mode": "primary",
      "prompt": "{file:.opencode/agent/cmo.md}"
    },
    "data-analyst": {
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/data-analyst.md}"
    },
    "social-listener": {
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/social-listener.md}"
    },
    "content-writer": {
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/content-writer.md}"
    },
    "designer": {
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/designer.md}"
    },
    "devops-engineer": {
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/devops-engineer.md}"
    },
    "distiller": {
      "mode": "subagent",
      "prompt": "{file:.opencode/agent/distiller.md}"
    }
  },
  "mcp": {
    "google-analytics": {
      "type": "local",
      "command": [
        "uvx",
        "google-analytics-mcp"
      ],
      "enabled": false,
      "environment": {
        "GOOGLE_APPLICATION_CREDENTIALS": "{env:GOOGLE_APPLICATION_CREDENTIALS}",
        "GA4_PROPERTY_ID": "{env:GA4_PROPERTY_ID}"
      }
    },
    "google-search-console": {
      "type": "local",
      "command": [
        "uvx",
        "google-search-console-mcp"
      ],
      "enabled": false,
      "environment": {
        "GOOGLE_APPLICATION_CREDENTIALS": "{env:GOOGLE_APPLICATION_CREDENTIALS}"
      }
    }
  }
}
